<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Backdating de cotización para gerencia.
         El nativo maneja date_order con un patrón de dos pares label/campo
         ("Quotation Date" / "Order Date") y lo oculta en borrador, así que no
         hay forma limpia de destrabar ESE nodo. En vez de pelear con esa
         marcación, agregamos un campo date_order propio, visible y rotulado,
         debajo del Cliente: editable solo si es gerente de ventas
         (is_sale_manager) y el presupuesto sigue en borrador/enviado. Al resto
         le queda readonly. El candado de fecha pasada vive en action_confirm(). -->
    <record id="view_order_form_backdating" model="ir.ui.view">
        <field name="name">sale.order.form.backdating</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="is_sale_manager" invisible="1"/>
                <field name="date_order" string="Fecha de la orden"
                       readonly="not is_sale_manager or state not in ('draft', 'sent')"/>
            </field>
        </field>
    </record>
</odoo>
